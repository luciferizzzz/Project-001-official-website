{
  "name": "project-001-website",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Official website for Project 001, an independent technology collective.",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "verify": "node scripts/verify-build.mjs",
    "typecheck": "tsc -b --pretty false",
    "clean": "node scripts/clean.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.6"
  }
}
